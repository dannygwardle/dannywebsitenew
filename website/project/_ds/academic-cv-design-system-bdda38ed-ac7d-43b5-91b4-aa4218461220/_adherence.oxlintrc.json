{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/document/**",
              "components/ui/**",
              "ui_kits/academic_site/**",
              "ui_kits/cv_document/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Crimson Text|Source Sans 3))/i]",
        "message": "Font not provided by the design system. Available: Crimson Text, Source Sans 3."
      },
      {
        "selector": "JSXOpeningElement[name.name='BulletList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|children|marker|style|key|ref|className|style|children)$/]",
        "message": "<BulletList> doesn't accept that prop. Declared props: items, children, marker, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|iconLeft|iconRight|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, iconLeft, iconRight, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|link)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DocMasthead'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|contact|style|key|ref|className|style|children)$/]",
        "message": "<DocMasthead> doesn't accept that prop. Declared props: name, contact, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EntryHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|date|subtitle|meta|italicSubtitle|style|key|ref|className|style|children)$/]",
        "message": "<EntryHeader> doesn't accept that prop. Declared props: title, date, subtitle, meta, italicSubtitle, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Link'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|variant|style|key|ref|className|style|children)$/]",
        "message": "<Link> doesn't accept that prop. Declared props: children, href, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Link'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|subtle|plain)$/]",
        "message": "<Link> variant must be one of 'default' | 'subtle' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PublicationEntry'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|venues|quoted|style|key|ref|className|style|children)$/]",
        "message": "<PublicationEntry> doesn't accept that prop. Declared props: title, venues, quoted, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|as|accent|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: children, as, accent, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:h1|h2|h3|h4)$/]",
        "message": "<SectionHeader> as must be one of 'h1' | 'h2' | 'h3' | 'h4'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:soft|outline|solid|maroon)$/]",
        "message": "<Tag> tone must be one of 'soft' | 'outline' | 'solid' | 'maroon'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
